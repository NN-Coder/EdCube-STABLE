{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "edcube",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js APIs for Next.js compatibility
    "nodejs_compat",
    // Allow fetching public URLs from within the worker
    "global_fetch_strictly_public"
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://hftvwwtqznujktobbxol.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_nvAJbIyh32mLYlMmCAUeaQ_IERYW9SX",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY": "sb_publishable_nvAJbIyh32mLYlMmCAUeaQ_IERYW9SX",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_nvAJbIyh32mLYlMmCAUeaQ_IERYW9SX",
    "NEXT_PUBLIC_SITE_URL": "https://edcube.edcube.workers.dev"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // Must match the "name" field above
      "service": "edcube"
    }
  ],
  "r2_buckets": [
    // Next.js ISR/SSG incremental cache
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "edcube-cache"
    },
    // Game assets bucket (contains game_sources/*)
    {
      "binding": "GAME_ASSETS_BUCKET",
      "bucket_name": "assets"
    }
  ],
  "hyperdrive": [
    {
      // Hyperdrive connection pooler for Supabase Postgres (edcube-db).
      // Manages a warm connection pool at the Cloudflare edge — no TCP overhead per request.
      // localConnectionString: used ONLY by wrangler for local emulation (opennextjs deploy calls getPlatformProxy).
      // In production, Cloudflare routes via the real Hyperdrive pool (id above).
      "binding": "HYPERDRIVE",
      "id": "b674fc1f3a4f4969968d690bf2aa9a77",
      "localConnectionString": "postgres://dummy:dummy@localhost:5432/dummy"
    }
  ]
}